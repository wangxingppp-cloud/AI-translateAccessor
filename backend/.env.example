# ── Server ────────────────────────────────────────────────
# PORT=0 means OS auto-assign (desktop packaging default).
# Set a fixed port for dev (e.g. 8000) for predictable URLs.
HOST=127.0.0.1
PORT=0
LOG_LEVEL=INFO

# ── Paths (relative to backend/ or absolute) ──────────────
# Leave empty for defaults: ./data and ./models next to backend/
DATA_DIR=
MODELS_DIR=

# ── ASR (Sherpa-onnx) ────────────────────────────────────
# ASR_MODEL_PATH defaults to $MODELS_DIR/sherpa-onnx-paraformer
ASR_MODEL_PATH=
ASR_ENCODER=
ASR_DECODER=
ASR_TOKENS=

# ── Translation ───────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
ENABLE_CORRECTION=true

# ── Redis (optional, leave empty to skip) ────────────────
REDIS_URL=
